---
import BaseLayout from "../layouts/BaseLayout.astro";

// To add a document, put the PDF in public/policies/ and add a line here.
const documents = [
	{ file: "Corporate_Social_Responsibility_Policy.pdf", title: "Corporate Social Responsibility Policy" },
	{ file: "Equality_Diversity_Inclusion_Policy.pdf", title: "Equality, Diversity & Inclusion Policy" },
	{ file: "Environmental_Statement.pdf", title: "Environmental Statement" },
	{ file: "Health_and_Safety_Policy.pdf", title: "Health & Safety Policy" },
	{ file: "Modern_Slavery_Statement.pdf", title: "Modern Slavery Statement" },
	{ file: "Data_Protection_Privacy_Policy.pdf", title: "Data Protection & Privacy Policy" },
];
---

<BaseLayout title="Reports, Certifications & Policies">
	<section class="page-top">
		<div class="container narrow">
			<span class="eyebrow">Documents</span>
			<h1>Reports, certifications &amp; policies</h1>
			<div class="divider"></div>
			<p>Download key documents below. Each opens as a PDF.</p>

			<ul class="docs">
				{
					documents.map((doc) => (
						<li>
							<a href={`/policies/${doc.file}`} target="_blank" rel="noopener">
								<span>{doc.title}</span>
								<span class="tag">PDF</span>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</BaseLayout>

<style>
	.docs {
		list-style: none;
		padding: 0;
		margin-top: 2rem;
	}

	.docs li {
		margin-bottom: 0.75rem;
	}

	.docs a {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		padding: 1rem 1.25rem;
		border: 1px solid var(--border);
		border-radius: 8px;
		background: var(--surface);
		color: var(--text);
		text-decoration: none;
		transition: border-color 0.2s ease;
	}

	.docs a:hover {
		border-color: var(--accent2);
	}

	.tag {
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--accent2);
	}
</style>
