---
// The blog is hidden for now: it isn't linked from the menu, is left out of
// the sitemap, and has noindex set. Visit /blog directly to see it.
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import FormattedDate from "../../components/FormattedDate.astro";

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Blog" noindex>
	<section class="page-top">
		<div class="container narrow">
			<span class="eyebrow">Blog</span>
			<h1>News &amp; notes</h1>
			<div class="divider"></div>

			<div class="posts">
				{
					posts.map((post) => (
						<a href={`/blog/${post.id}/`} class="card">
							<p class="date">
								<FormattedDate date={post.data.pubDate} />
							</p>
							<h3>{post.data.title}</h3>
							<p>{post.data.description}</p>
						</a>
					))
				}
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.posts {
		display: grid;
		gap: 1.25rem;
	}
	.date {
		font-size: 0.85rem;
		margin-bottom: 0.25rem;
	}
</style>
