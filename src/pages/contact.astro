---
import BaseLayout from "../layouts/BaseLayout.astro";
import { EMAIL, PHONE, PHONE_LINK, AREA } from "../consts";
---

<BaseLayout title="Contact" description="Get in touch about lighting, effects or systems support for your next production.">
	<section class="page-top">
		<div class="container split">
			<div>
				<span class="eyebrow">Contact</span>
				<h1>Let's make your vision <span class="gradient-text">a reality</span>.</h1>
				<p class="lead">
					Tell me about your production: what it is, where, and when. I'll get back to you as soon as I can.
				</p>
				<p class="details">
					<a href={`mailto:${EMAIL}`}>{EMAIL}</a><br />
					<a href={`tel:${PHONE_LINK}`}>{PHONE}</a><br />
					{AREA}
				</p>
			</div>

			<form action="https://formspree.io/f/xdaynbyn" method="POST" class="card glow-2">
				<div>
					<label for="name">Name</label>
					<input id="name" type="text" name="name" autocomplete="name" required />
				</div>
				<div>
					<label for="email">Email</label>
					<input id="email" type="email" name="email" autocomplete="email" required />
				</div>
				<div>
					<label for="message">Message</label>
					<textarea id="message" name="message" placeholder="Production, dates, location and what you need" required></textarea>
				</div>

				<!-- Spam trap: hidden from people, filled in by bots -->
				<input type="text" name="_gotcha" class="sr-only" tabindex="-1" autocomplete="off" aria-hidden="true" />
				<input type="hidden" name="_subject" value="New enquiry from stangroom.uk" />

				<button type="submit" class="button">Send message</button>
			</form>
		</div>
	</section>
</BaseLayout>

<style>
	.split {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3rem;
		align-items: start;
	}

	.details {
		margin-top: 2rem;
	}

	.details a {
		color: var(--text);
	}

	form {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	form .button {
		align-self: flex-start;
	}

	@media (max-width: 800px) {
		.split {
			grid-template-columns: 1fr;
		}
	}
</style>
