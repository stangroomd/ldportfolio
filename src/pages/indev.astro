---
// The new homepage, in development. The live homepage (src/pages/index.astro)
// shows "Coming Soon" until this is ready. See README.md to switch over.
import BaseLayout from "../layouts/BaseLayout.astro";
import { IMAGES } from "../consts";
---

<BaseLayout noindex>
	<!-- HERO -->
	<div
		class:list={["hero", { "has-image": IMAGES.hero }]}
		style={IMAGES.hero ? `--hero-image: url('${IMAGES.hero}')` : undefined}
	>
		<div class="container">
			<span class="eyebrow">Live events · Film · Broadcast</span>
			<h1>
				Light, and the systems<br />
				<span class="gradient-text">behind it.</span>
			</h1>
			<p class="lead">
				A freelance technician for lighting and LED, with the IP networking, RF and power systems that keep it all connected. Hands-on support on site, with design and planning when you need it.
			</p>
			<div class="actions">
				<a href="/contact" class="button">Get in touch</a>
				<a href="/services" class="button ghost">See services</a>
			</div>
		</div>
	</div>

	<!-- WHAT I DO -->
	<section>
		<div class="container">
			<h2>What I do</h2>
			<div class="divider"></div>

			<div class="cards">
				<a href="/services#light" class="card glow-1">
					<h3>Lighting &amp; LED</h3>
					<p>If it emits light, I can rig it, programme it and run it, from lighting fixtures to LED screens.</p>
				</a>
				<a href="/services#systems" class="card glow-2">
					<h3>Networks, RF &amp; power</h3>
					<p>IP networking, RF coordination and temporary power, built so every department can rely on it.</p>
				</a>
				<a href="/services#planning" class="card glow-3">
					<h3>Design &amp; planning</h3>
					<p>Pre-production support, from system design and equipment planning through to paperwork and prep.</p>
				</a>
			</div>
		</div>
	</section>

	<!-- HOW I WORK -->
	<section>
		<div class="container narrow">
			<h2>Your production, carried through</h2>
			<div class="divider"></div>
			<p>
				Every production has its own demands, pressures and identity. I work alongside producers, designers and technical teams as an extra pair of experienced hands, focused on getting your vision into reality safely, reliably and on time.
			</p>
			<p>
				Whether you need a crew member for the day, a technician to look after a system for the full run, or someone to plan it from the start, all work is delivered to a high standard of safety and compliance.
			</p>
			<p><a href="/mission-statement">Read my mission statement →</a></p>
		</div>
	</section>

	<!-- ILLUMINATING FUTURES -->
	<section>
		<div class="container">
			<div class="card glow-3 feature">
				<span class="eyebrow">Illuminating Futures</span>
				<h2>Opening doors for young people</h2>
				<p>
					The industry can be hard to get into. Through Illuminating Futures, aspiring young people can shadow me on real productions and gain experience that is otherwise hard to come by.
				</p>
				<a href="/illuminating-futures" class="button ghost">Find out more</a>
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="cta">
		<div class="container">
			<h2>Got a production coming up?</h2>
			<p>Tell me what you're working on, and when.</p>
			<div class="actions">
				<a href="/contact" class="button">Get in touch</a>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.hero {
		position: relative;
		display: flex;
		align-items: center;
		min-height: 92vh;
		padding: 8rem 0 4rem;
		overflow: hidden;
	}

	/* Placeholder: stage-light beams drawn in CSS. Faded out at the bottom
	   so it blends into the page. */
	.hero::before {
		content: "";
		position: absolute;
		inset: -10% 0 0;
		background:
			conic-gradient(from 160deg at 12% 0%, transparent 0deg, rgba(0, 212, 255, 0.35) 9deg, transparent 18deg, transparent),
			conic-gradient(from 172deg at 34% 0%, transparent 0deg, rgba(124, 92, 255, 0.45) 8deg, transparent 16deg, transparent),
			conic-gradient(from 178deg at 50% 0%, transparent 0deg, rgba(255, 78, 205, 0.35) 6deg, transparent 12deg, transparent),
			conic-gradient(from 184deg at 66% 0%, transparent 0deg, rgba(124, 92, 255, 0.45) 8deg, transparent 16deg, transparent),
			conic-gradient(from 194deg at 88% 0%, transparent 0deg, rgba(0, 212, 255, 0.35) 9deg, transparent 18deg, transparent);
		filter: blur(10px);
		-webkit-mask-image: linear-gradient(to bottom, #000 40%, transparent 100%);
		mask-image: linear-gradient(to bottom, #000 40%, transparent 100%);
	}

	/* Photo, when one is set in src/consts.ts: darkened on the left so the
	   text stays readable, and faded out at the bottom. */
	.hero.has-image::before {
		inset: 0;
		background:
			linear-gradient(90deg, rgba(11, 12, 16, 0.92) 0%, rgba(11, 12, 16, 0.6) 60%, rgba(11, 12, 16, 0.3) 100%),
			var(--hero-image) center / cover no-repeat;
		filter: none;
		-webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent 100%);
		mask-image: linear-gradient(to bottom, #000 55%, transparent 100%);
	}

	.hero .container {
		position: relative;
		z-index: 1;
	}

	.hero h1 {
		font-size: clamp(2.5rem, 6.5vw, 4.5rem);
	}

	.hero .lead {
		color: #c9ccd2;
	}

	.feature {
		padding: 3rem;
	}

	.feature p {
		max-width: 640px;
	}

	.cta {
		text-align: center;
	}

	.cta .actions {
		justify-content: center;
	}

	@media (max-width: 560px) {
		.feature {
			padding: 2rem 1.5rem;
		}
	}
</style>
