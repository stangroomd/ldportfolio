---
// Main navigation. Add or remove links in this list.
const links = [
	{ href: "/services", label: "Services" },
	{ href: "/illuminating-futures", label: "Illuminating Futures" },
	{ href: "/contact", label: "Contact" },
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header>
	<nav class="container" aria-label="Main">
		<a href="/" class="logo">stangroom<span class="gradient-text">.uk</span></a>
		<ul>
			{
				links.map((link) => (
					<li>
						<a href={link.href} aria-current={path === link.href ? "page" : undefined}>
							{link.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>

<style>
	header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 100;
		background: rgba(11, 12, 16, 0.6);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--border);
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		min-height: 4rem;
	}

	.logo {
		font-weight: 700;
		font-size: 1.1rem;
		color: var(--text);
		text-decoration: none;
		white-space: nowrap;
	}

	ul {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 0.25rem 1.75rem;
		list-style: none;
		padding: 0;
		margin: 0;
	}

	li {
		margin: 0;
	}

	ul a {
		color: var(--text);
		text-decoration: none;
		font-size: 0.95rem;
		opacity: 0.8;
		padding: 0.25rem 0;
		border-bottom: 2px solid transparent;
	}

	ul a:hover,
	ul a[aria-current="page"] {
		opacity: 1;
		border-bottom-color: var(--accent2);
	}

	@media (max-width: 560px) {
		nav {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.25rem;
			padding-top: 0.6rem;
			padding-bottom: 0.6rem;
		}
		ul {
			justify-content: flex-start;
			gap: 0.25rem 1.25rem;
		}
		ul a {
			font-size: 0.9rem;
		}
	}
</style>
