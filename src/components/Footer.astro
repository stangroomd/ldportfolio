---
import { EMAIL, PHONE, PHONE_LINK, AREA, HOME } from "../consts";

// Footer links. Pages listed here don't need to be in the main navigation.
const links = [
	{ href: "/mission-statement", label: "Mission statement" },
	{ href: "/reports-policies", label: "Reports, certifications & policies" },
	{ href: "/contact", label: "Contact" },
];
---

<footer>
	<div class="container inner">
		<div>
			<a href={HOME} class="logo">stangroom<span class="gradient-text">.uk</span></a>
			<p>
				<a href={`mailto:${EMAIL}`}>{EMAIL}</a><br />
				<a href={`tel:${PHONE_LINK}`}>{PHONE}</a><br />
				{AREA}
			</p>
		</div>

		<ul>
			{links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
		</ul>
	</div>
	<p class="container copyright">&copy; {new Date().getFullYear()} stangroom.uk</p>
</footer>

<style>
	footer {
		position: relative;
		z-index: 1;
		border-top: 1px solid var(--border);
		padding: 3rem 0 2rem;
		font-size: 0.95rem;
	}

	.inner {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 2rem;
	}

	.logo {
		display: inline-block;
		font-weight: 700;
		color: var(--text);
		text-decoration: none;
		margin-bottom: 0.75rem;
	}

	p a {
		color: var(--muted);
		text-decoration: none;
	}

	p a:hover {
		color: var(--accent2);
	}

	ul {
		list-style: none;
		padding: 0;
	}

	ul a {
		color: var(--text);
		text-decoration: none;
		opacity: 0.8;
	}

	ul a:hover {
		opacity: 1;
		text-decoration: underline;
	}

	.copyright {
		margin-top: 2rem;
		margin-bottom: 0;
		font-size: 0.85rem;
		opacity: 0.6;
	}
</style>
