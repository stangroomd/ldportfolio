---
// Every page uses this layout: it adds the <head>, background glow,
// navigation bar and footer. Pages only supply their own content.
import BaseHead from "../components/BaseHead.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
	title?: string;
	description?: string;
	image?: string;
	noindex?: boolean;
}

const props = Astro.props;
---

<!doctype html>
<html lang="en-GB">
	<head>
		<BaseHead {...props} />
	</head>
	<body>
		<div class="blob one" aria-hidden="true"></div>
		<div class="blob two" aria-hidden="true"></div>
		<div class="blob three" aria-hidden="true"></div>

		<Navbar />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>
